<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brown_50">

    <!-- 스크롤 콘텐츠 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- 오늘 추가된 기록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_record_summary"
                android:layout_marginBottom="12dp">

                <!-- 헤더 행 -->
                <LinearLayout
                    android:id="@+id/card_today_records"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="오늘 추가된 기록"
                        android:textColor="@color/brown_700"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_record_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0개"
                        android:textColor="@color/brown_400"
                        android:textSize="13sp"
                        android:background="@drawable/bg_badge_count"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/ic_toggle_records"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:tint="@color/brown_400" />

                </LinearLayout>

                <!-- 펼쳐지는 콘텐츠 -->
                <LinearLayout
                    android:id="@+id/layout_records_expanded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 기록 목록 (동적 생성) -->
                    <LinearLayout
                        android:id="@+id/layout_records_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp" />

                    <!-- 빈 상태 -->
                    <LinearLayout
                        android:id="@+id/layout_records_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="아직 추가된 기록이 없어요"
                            android:textColor="@color/brown_500"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="아래에서 첫 기록을 추가해보세요"
                            android:textColor="@color/brown_400"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 기록 방식 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_section"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기록 방식 선택"
                    android:textColor="@color/brown_700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- 사진 버튼 -->
                    <LinearLayout
                        android:id="@+id/btn_type_photo"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_record_type_btn">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_camera"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="사진"
                            android:textColor="@color/brown_500"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- 텍스트 버튼 -->
                    <LinearLayout
                        android:id="@+id/btn_type_text"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_record_type_btn_selected"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_text_type"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="텍스트"
                            android:textColor="@color/brown_700"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- 음성 버튼 -->
                    <LinearLayout
                        android:id="@+id/btn_type_voice"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_record_type_btn">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_mic"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="음성"
                            android:textColor="@color/brown_500"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 사진 업로드 카드 -->
            <LinearLayout
                android:id="@+id/card_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_section"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 업로드"
                    android:textColor="@color/brown_700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <FrameLayout
                    android:id="@+id/area_photo_upload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_photo_upload_area">

                    <!-- 플레이스홀더 -->
                    <LinearLayout
                        android:id="@+id/layout_photo_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_image"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="사진을 업로드하세요"
                            android:textColor="@color/brown_500"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JPG, PNG, GIF (최대 10MB)"
                            android:textColor="@color/brown_300"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <!-- 선택된 사진 미리보기 -->
                    <ImageView
                        android:id="@+id/iv_photo_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- 음성 녹음 카드 -->
            <LinearLayout
                android:id="@+id/card_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_section"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="음성 녹음"
                    android:textColor="@color/brown_700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <!-- 녹음 상태 영역 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_memo"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- 마이크 아이콘 원 (IDLE일 때 탭하면 녹음 시작) -->
                    <FrameLayout
                        android:id="@+id/fl_voice_icon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_voice_btn_circle"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mic_button"
                            android:tint="@android:color/white" />

                    </FrameLayout>

                    <!-- 파형 (녹음 중만 표시) -->
                    <TextView
                        android:id="@+id/tv_waveform"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▌  ▌  ▌  ▌  ▌"
                        android:textColor="@color/sub_200"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <!-- 상태 텍스트 -->
                    <TextView
                        android:id="@+id/tv_voice_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="녹음 버튼을 눌러 시작하세요"
                        android:textColor="@color/brown_500"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <!-- 타이머 -->
                    <TextView
                        android:id="@+id/tv_voice_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/brown_800"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <!-- 녹음 제어 버튼 (녹음 중 / 일시정지 상태) -->
                    <LinearLayout
                        android:id="@+id/layout_record_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/btn_pause_resume"
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:text="일시정지"
                            android:textColor="@color/brown_700"
                            android:textSize="14sp"
                            android:background="@drawable/bg_record_type_btn"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/btn_record_done"
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:text="완료"
                            android:textColor="@color/brown_50"
                            android:textSize="14sp"
                            android:background="@drawable/bg_btn_voice_done" />

                    </LinearLayout>

                    <!-- 재생 컨트롤 (녹음 완료 / 재생 상태) -->
                    <LinearLayout
                        android:id="@+id/layout_playback_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/btn_play_pause_voice"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_voice_btn_circle"
                            android:src="@drawable/ic_play"
                            android:padding="10dp"
                            android:contentDescription="재생"
                            android:layout_marginEnd="12dp" />

                        <ProgressBar
                            android:id="@+id/pb_playback"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_weight="1"
                            android:progress="0"
                            android:progressTint="@color/sub_200"
                            android:progressBackgroundTint="@color/brown_200" />

                    </LinearLayout>

                    <!-- 다시 녹음하기 -->
                    <TextView
                        android:id="@+id/tv_re_record"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다시 녹음하기"
                        android:textColor="@color/brown_400"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- STT 결과 (녹음 완료 후 표시) -->
                    <LinearLayout
                        android:id="@+id/layout_stt_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_stt_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="음성 변환 텍스트"
                            android:textColor="@color/brown_500"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/et_stt_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_memo"
                            android:padding="12dp"
                            android:textColor="@color/brown_900"
                            android:textSize="14sp"
                            android:hint="변환 중..."
                            android:textColorHint="@color/brown_300"
                            android:minLines="2"
                            android:gravity="top|start"
                            android:inputType="textMultiLine" />

                    </LinearLayout>

                    <!-- 힌트 (IDLE만 표시) -->
                    <TextView
                        android:id="@+id/tv_voice_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대 10초까지 녹음 가능"
                        android:textColor="@color/brown_300"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 메모 작성 카드 -->
            <LinearLayout
                android:id="@+id/card_memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_section"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="메모 작성"
                    android:textColor="@color/brown_700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_memo"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_input_memo"
                    android:padding="12dp"
                    android:textColor="@color/brown_800"
                    android:textColorHint="@color/brown_300"
                    android:hint="지금 이 순간의 기억을 남겨보세요...."
                    android:textSize="14sp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLines="10" />

            </LinearLayout>

            <!-- 위치 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_section"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위치"
                    android:textColor="@color/brown_700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- 위치 입력 필드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_memo"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_location"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/et_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:textColor="@color/brown_800"
                        android:textColorHint="@color/brown_300"
                        android:hint="장소를 입력해주세요"
                        android:textSize="14sp"
                        android:padding="0dp"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- 현재 위치 체크박스 -->
                <CheckBox
                    android:id="@+id/cb_current_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 위치로 기록"
                    android:textColor="@color/brown_400"
                    android:textSize="13sp"
                    android:buttonTint="@color/sub_200" />

            </LinearLayout>

            <!-- 시간 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_section"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시간"
                    android:textColor="@color/brown_700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- 시간 입력 필드 -->
                <LinearLayout
                    android:id="@+id/layout_time_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_memo"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clock"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_time_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/brown_800"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- 현재 시간 체크박스 -->
                <CheckBox
                    android:id="@+id/cb_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 시간으로 기록"
                    android:textColor="@color/brown_400"
                    android:textSize="13sp"
                    android:buttonTint="@color/sub_200" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 저장 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_save_btn">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_save_memory"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_save_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기억조각 저장하기"
                android:textColor="@color/brown_50"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
