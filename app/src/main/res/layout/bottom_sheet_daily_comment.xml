<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="32dp">

    <!-- 핸들 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- AI 뱃지 + 타이틀 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textColor="@color/main_200"
            android:textSize="14sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 한마디"
            android:textColor="@color/brown_600"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 코멘트 텍스트 -->
    <TextView
        android:id="@+id/tv_daily_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brown_800"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="20dp" />

    <!-- 닫기 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="오늘도 좋은 하루 보내기"
        android:textSize="14sp"
        app:backgroundTint="@color/main_200"
        app:cornerRadius="12dp" />

</LinearLayout>
