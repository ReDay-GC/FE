<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_100">

    <!-- 헤더 + 스텝 인디케이터 (그라데이션 배경) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_gradient">

        <!-- 헤더 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_close"
                android:src="@drawable/ic_chevron_left"
                android:padding="8dp"
                android:contentDescription="뒤로"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기억 추가"
                android:textColor="@color/brown_700"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_close"
                android:src="@drawable/ic_close"
                android:padding="8dp"
                android:contentDescription="닫기"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 스텝 인디케이터 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/step1_circle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_step_active"
                android:text="1"
                android:textColor="@color/brown_50"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/step1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="날짜 선택"
                android:textColor="@color/brown_700"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />

            <View
                android:id="@+id/step_divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/inactive"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/step2_circle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_step_inactive"
                android:text="2"
                android:textColor="@color/brown_300"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/step2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기억 추가"
                android:textColor="@color/brown_300"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- 선택된 날짜 텍스트 (step 2에서만 표시) -->
        <TextView
            android:id="@+id/tv_selected_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="@color/brown_500"
            android:textSize="14sp"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inactive" />

    <!-- Fragment 컨테이너 -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
