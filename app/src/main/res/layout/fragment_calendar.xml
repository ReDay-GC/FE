<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brown_100">

    <!-- 캘린더 카드 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/brown_50"
                android:padding="20dp">

                <!-- 캘린더 카드 타이틀 + 월 이동 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:id="@+id/iv_calendar_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_calendar"
                        app:tint="@color/brown_700"
                        android:contentDescription="캘린더"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_calendar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3월 캘린더"
                        android:textColor="@color/brown_700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/iv_calendar_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageButton
                        android:id="@+id/btn_next_month"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="다음 달"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageButton
                        android:id="@+id/btn_prev_month"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_chevron_left"
                        android:contentDescription="이전 달"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintEnd_toStartOf="@id/btn_next_month"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 요일 헤더 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="일"
                        android:textColor="@color/red"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="월"
                        android:textColor="@color/brown_600"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="화"
                        android:textColor="@color/brown_600"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="수"
                        android:textColor="@color/brown_600"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="목"
                        android:textColor="@color/brown_600"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="금"
                        android:textColor="@color/brown_600"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="32dp"
                        android:text="토"
                        android:textColor="@color/blue"
                        android:textSize="13sp"
                        android:gravity="center" />

                </GridLayout>

                <!-- 날짜 그리드 (동적 생성) -->
                <LinearLayout
                    android:id="@+id/grid_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 범례 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_legend_today" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘"
                        android:textColor="@color/brown_700"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="14dp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_legend_has_record" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기록 있음"
                        android:textColor="@color/brown_700"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="14dp" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_legend_recording" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="기록 중"
                        android:textColor="@color/brown_700"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 기록 없는 날 선택 시 빈 상태 카드 -->
            <LinearLayout
                android:id="@+id/card_empty_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outline"
                android:layout_marginTop="12dp"
                android:padding="32dp"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_empty_day_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3월 10일"
                    android:textColor="@color/brown_700"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이 날의 기억이 없습니다"
                    android:textColor="@color/brown_500"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새로운 기록을 추가해보세요"
                    android:textColor="@color/brown_400"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 기록중 날 선택 시 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recording_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brown_50"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brown_300"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 헤더: 날짜 + 기록중 배지 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_recording_day_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3월 5일"
                            android:textColor="@color/brown_600"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_recording_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● 기록 중"
                            android:textColor="@color/brown_600"
                            android:textSize="12sp"
                            android:background="@drawable/bg_badge_recording"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <!-- 안내 문구 -->
                    <TextView
                        android:id="@+id/tv_recording_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0개의 기억 조각이 저장되어 있습니다\nAI를 생성하면 하나의 완성된 기억이 됩니다"
                        android:textColor="@color/brown_500"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="16dp" />

                    <!-- 기록 조각 목록 (동적 생성) -->
                    <LinearLayout
                        android:id="@+id/ll_recording_fragments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp" />

                    <!-- AI 생성하러가기 버튼 -->
                    <LinearLayout
                        android:id="@+id/btn_generate_ai"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_ai_generate">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_star_ai"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI 생성하러가기"
                            android:textColor="@color/brown_50"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 선택된 날짜 기억 상세 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_memory_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brown_50"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/brown_300"
                app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 썸네일 + 제목 오버레이 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="160dp">

                    <ImageView
                        android:id="@+id/iv_detail_thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:background="@color/brown_200"
                        android:contentDescription="기억 썸네일" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_thumbnail_gradient" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_gravity="bottom">

                        <TextView
                            android:id="@+id/tv_detail_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/brown_50"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_detail_date_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/brown_200"
                            android:textSize="12sp" />

                    </LinearLayout>

                </FrameLayout>

                <!-- 본문 영역 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- AI 요약 배지 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 요약"
                        android:textColor="@color/sub_200"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_sub"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- AI 요약 텍스트 -->
                    <TextView
                        android:id="@+id/tv_detail_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brown_600"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5"
                        android:layout_marginBottom="12dp" />

                    <!-- 위치 + 사람 메타 -->
                    <LinearLayout
                        android:id="@+id/ll_detail_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp" />

                    <!-- 구분선 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/brown_200"
                        android:layout_marginBottom="14dp" />

                    <!-- 기록 조각 섹션 레이블 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECORDS"
                        android:textColor="@color/brown_400"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <!-- 기록 조각 목록 (동적 생성) -->
                    <LinearLayout
                        android:id="@+id/ll_detail_fragments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp" />

                    <!-- 태그 -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_detail_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="4dp"
                        app:chipSpacingVertical="4dp" />

                </LinearLayout>

            </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
