<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_section"
    android:layout_marginBottom="8dp">

    <!-- 요약 행 -->
    <LinearLayout
        android:id="@+id/row_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- 타입 아이콘 원 -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_record_icon_circle">

            <ImageView
                android:id="@+id/iv_type_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_text_type"
                android:tint="@color/main_200" />

        </FrameLayout>

        <!-- 제목 + 시간 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/brown_800"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/brown_400"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brown_400"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 펼치기 아이콘 -->
        <ImageView
            android:id="@+id/iv_toggle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/brown_400" />

    </LinearLayout>

    <!-- 펼쳐지는 상세 영역 -->
    <LinearLayout
        android:id="@+id/layout_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- 사진 미리보기 (PHOTO 타입만) -->
        <ImageView
            android:id="@+id/iv_photo_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_photo_preview_rounded"
            android:clipToOutline="true"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- 전체 텍스트 (TEXT 타입만) -->
        <TextView
            android:id="@+id/tv_full_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_memo"
            android:padding="12dp"
            android:textColor="@color/brown_700"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- 음성 플레이어 영역 (VOICE 타입만) -->
        <LinearLayout
            android:id="@+id/layout_voice_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_memo"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="음성 녹음"
                    android:textColor="@color/brown_700"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_voice_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brown_500"
                    android:textSize="13sp" />

            </LinearLayout>

            <ProgressBar
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progress="100"
                android:progressTint="@color/sub_200"
                android:progressBackgroundTint="@color/brown_200" />

        </LinearLayout>

        <!-- 위치 -->
        <LinearLayout
            android:id="@+id/row_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                android:tint="@color/brown_400"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brown_400"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 날짜 + 시간 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_clock"
                android:tint="@color/brown_400"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_full_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brown_400"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
