<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 상단 외곽선 (brown_950) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brown_950" />
        </shape>
    </item>

    <!-- 배경 (1dp 아래로 inset, 나머지 0) -->
