<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 외곽선 레이어 (brown_300 → brown_800 가로 그라데이션) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brown_300"
                android:endColor="@color/brown_800"
                android:angle="0" />
        </shape>
    </item>

    <!-- 배경 레이어 (1dp 안쪽으로 inset) -->
    <item
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFE8E0"
                android:centerColor="#FFE8E0"
                android:endColor="#F5F3EE"
                android:angle="90" />
        </shape>
    </item>

</layer-list>
